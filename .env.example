# Copy to .env.local and fill before production deploy.
# Never commit real secrets.

# Google Analytics 4 measurement ID (replace G-XXXXXXXXXX placeholder)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Discovery-call booking URL (Calendly, SavvyCal, Google Appointment, etc.)
# Leave blank to route CTAs to /contact with lane query params.
VITE_CALENDLY_URL=https://calendly.com/your-link/discovery

# Optional form webhook (Formspree, Cloudflare Worker, etc.)
VITE_CONTACT_FORM_ENDPOINT=
